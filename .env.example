# ─────────────────────────────────────────────
# Login Kommo (usuario/contraseña — sin OAuth)
# ─────────────────────────────────────────────
KOMMO_USERNAME=tu_correo@empresa.com
KOMMO_PASSWORD=tu_password

# ─────────────────────────────────────────────
# URLs de Kommo (no cambiar salvo subdominio)
# ─────────────────────────────────────────────
KOMMO_BASE_URL=https://tu_subdominio.kommo.com
KOMMO_AMOJO_BASE_URL=[REMOVED_PROVIDER_URL]

# ─────────────────────────────────────────────
# Intervalos de refresco (segundos)
# 600  = 10 min  → re-login cookies
# ─────────────────────────────────────────────
KOMMO_SESSION_REFRESH_INTERVAL=600
