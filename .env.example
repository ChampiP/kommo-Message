# ─────────────────────────────────────────────
# Login Kommo (usuario/contraseña — sin OAuth)
# ─────────────────────────────────────────────
KOMMO_USERNAME=tu_correo@empresa.com
KOMMO_PASSWORD=tu_password

# ─────────────────────────────────────────────
# URLs de Kommo (requeridas en entorno)
# ─────────────────────────────────────────────
KOMMO_BASE_URL=https://<tu-subdominio>.<dominio>
KOMMO_AMOJO_BASE_URL=https://<amojo-host>
KOMMO_WS_URL=wss://<ws-host>/<tu-subdominio>/v2/rtm?stand=v16
